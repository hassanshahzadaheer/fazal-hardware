# Development only. Packaged/customer builds never read .env — customers enter their
# own keys in the first-run wizard / Settings, stored in OS-backed secure storage.
# `.env` is gitignored; never commit real values.

# Optional dev fallback for the AI scanner (ignored in packaged builds).
GEMINI_API_KEY=

# Dev only: skip licence activation while running `npm run dev` (ignored in packaged builds).
# Leave unset to test the real activation flow against a local license-server.
FAZAL_DEV_LICENSE_BYPASS=

# Build-time (CI sets these as repository Variables; see docs/RELEASING.md):
# LICENSE_SERVER_URL=https://<your-production-license-host>
# LICENSE_PUBLIC_KEY_B64=<base64 of the Ed25519 PUBLIC key PEM>
# FAZAL_RELEASE=1
