# Licence server configuration. Real values go in your host's secret store, never in git.
PORT=8787
DATA_DIR=./data
# Ed25519 PRIVATE key from `npm run keygen`. Either the file path or the PEM (\n-escaped):
LICENSE_SIGNING_KEY_FILE=
LICENSE_SIGNING_KEY_PEM=
# >= 24 random chars (e.g. `openssl rand -base64 32`). Keys are stored as HMAC(pepper, key).
# Changing it later invalidates every issued key — back it up with the signing key.
KEY_HASH_PEPPER=
# Behind an HTTPS proxy/host: true. Local http dev: false.
SECURE_COOKIES=true
TRUST_PROXY=true
# Run API and dashboard together (default) or split by toggling:
API_ENABLED=true
ADMIN_ENABLED=true
DEFAULT_GRACE_DAYS=7
DEFAULT_RECHECK_HOURS=6
BACKUP_KEEP=14
