{
  "name": "fazal-license-server",
  "version": "1.0.0",
  "private": true,
  "description": "Licensing service + owner dashboard for Fazal POS. Deployed separately from the desktop app.",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
